DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://platform_user:platform_pass@localhost:5432/platform_db

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_LIFETIME_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5

PAYMENT_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret
SUBSCRIPTION_GRACE_PERIOD_DAYS=7